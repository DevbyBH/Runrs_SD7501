@model List<Runrs.Models.ShoppingCart>

@{
    ViewData["Title"] = "My Cart";
    ViewData["BodyClass"] = "home-page";
    var total = ViewBag.Total as decimal? ?? 0;
}

<body>
    <svg class="background-svg" preserveAspectRatio="xMidYMid slice" viewBox="10 10 80 80">
        <defs>
            <style>
                @@keyframes rotate {
                    0% {
                        transform: rotate(0deg);
                    }

                    100% {
                        transform: rotate(360deg);
                    }
                }

                .out-top {
                    animation: rotate 40s linear infinite;
                    transform-origin: 13px 25px;
                }

                .in-top {
                    animation: rotate 20s linear infinite;
                    transform-origin: 13px 25px;
                }

                .out-bottom {
                    animation: rotate 50s linear infinite;
                    transform-origin: 84px 93px;
                }

                .in-bottom {
                    animation: rotate 30s linear infinite;
                    transform-origin: 84px 93px;
                }
            </style>
        </defs>
        <path fill="#833AB4" class="out-top" d="M37-5C25.1-14.7,5.7-19.1-9.2-10-28.5,1.8-32.7,31.1-19.8,49c15.5,21.5,52.6,22,67.2,2.3C59.4,35,53.7,8.5,37-5Z" />
        <path fill="#2a1344" class="in-top" d="M20.6,4.1C11.6,1.5-1.9,2.5-8,11.2-16.3,23.1-8.2,45.6,7.4,50S42.1,38.9,41,24.5C40.2,14.1,29.4,6.6,20.6,4.1Z" />
        <path fill="#833AB4" class="out-bottom" d="M105.9,48.6c-12.4-8.2-29.3-4.8-39.4.8-23.4,12.8-37.7,51.9-19.1,74.1s63.9,15.3,76-5.6c7.6-13.3,1.8-31.1-2.3-43.8C117.6,63.3,114.7,54.3,105.9,48.6Z" />
        <path fill="#2a1344" class="in-bottom" d="M102,67.1c-9.6-6.1-22-3.1-29.5,2-15.4,10.7-19.6,37.5-7.6,47.8s35.9,3.9,44.5-12.5C115.5,92.6,113.9,74.6,102,67.1Z" />
    </svg>

    <div class="container mt-4">
        <div class="crud-form shadow border-0 mt-4">
            <div class="crud-card-header-box ml-0 py-3">
                <div class="crud-card-header">
                    <h2 class="crud-header-text py-2">
                        <i class="bi bi-cart-fill"></i> My Cart
                    </h2>
                    <p class="text-white">Review your event registrations before checkout</p>
                </div>
            </div>

            <div class="dashboard-card-body p-4">

                @if (Model == null || !Model.Any())
                {
                    <p class="text-white text-center mt-3">
                        Your cart is empty.
                        <a asp-controller="Search" asp-action="Index" class="text-warning">
                            Browse clubs
                        </a>
                        to find events.
                    </p>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <div class="cart-item mb-3">
                            <div class="cart-item-details">
                                <h5 class="text-white">@item.Event?.EventTitle</h5>
                                <p class="text-muted mb-1">
                                    <i class="bi bi-building"></i>
                                    @item.Event?.Club?.ClubName
                                </p>
                                <p class="text-muted mb-1">
                                    <i class="bi bi-calendar-event"></i>
                                    @item.Event?.EventDate.ToString("dd MMM yyyy h:mm tt")
                                </p>
                                <p class="text-muted">
                                    <i class="bi bi-geo-alt-fill"></i>
                                    @item.Event?.EventLocation
                                </p>
                            </div>
                            <div class="cart-item-price">
                                <h5 style="color: #FF7614;">
                                    $@item.Event?.EntryFee NZD
                                </h5>
                                <form action="/ShoppingCart/Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartId" value="@item.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm mt-2">
                                        <i class="bi bi-trash3-fill"></i> Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                        <hr style="border-color: rgba(255,255,255,0.1);" />
                    }

                    <!-- Total -->
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <h4 class="text-white">Total</h4>
                        <h4 style="color: #FF7614;">$@total NZD</h4>
                    </div>

                    <!-- Checkout Button -->
                    <div class="d-flex gap-3 mt-4">
                        <form action="/ShoppingCart/Checkout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-custom px-4">
                                <i class="bi bi-credit-card"></i> Proceed to Checkout
                            </button>
                        </form>
                        <a asp-controller="Search" asp-action="Index"
                           class="btn btn-secondary px-4">
                            <i class="bi bi-arrow-left"></i> Continue Browsing
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</body>