@model List<Runrs.Models.ShoppingCart>

@{
    ViewData["Title"] = "My Cart";
    ViewData["BodyClass"] = "home-page";
    var total = ViewBag.Total as decimal? ?? 0;
}

<body>
    <svg class="background-svg" preserveAspectRatio="xMidYMid slice" viewBox="10 10 80 80">
        <defs>
            <style>
                @@keyframes rotate {
                    0% {
                        transform: rotate(0deg);
                    }

                    100% {
                        transform: rotate(360deg);
                    }
                }

                .out-top {
                    animation: rotate 40s linear infinite;
                    transform-origin: 13px 25px;
                }

                .in-top {
                    animation: rotate 20s linear infinite;
                    transform-origin: 13px 25px;
                }

                .out-bottom {
                    animation: rotate 50s linear infinite;
                    transform-origin: 84px 93px;
                }

                .in-bottom {
                    animation: rotate 30s linear infinite;
                    transform-origin: 84px 93px;
                }
            </style>
        </defs>
        <path fill="#833AB4" class="out-top" d="M37-5C25.1-14.7,5.7-19.1-9.2-10-28.5,1.8-32.7,31.1-19.8,49c15.5,21.5,52.6,22,67.2,2.3C59.4,35,53.7,8.5,37-5Z" />
        <path fill="#2a1344" class="in-top" d="M20.6,4.1C11.6,1.5-1.9,2.5-8,11.2-16.3,23.1-8.2,45.6,7.4,50S42.1,38.9,41,24.5C40.2,14.1,29.4,6.6,20.6,4.1Z" />
        <path fill="#833AB4" class="out-bottom" d="M105.9,48.6c-12.4-8.2-29.3-4.8-39.4.8-23.4,12.8-37.7,51.9-19.1,74.1s63.9,15.3,76-5.6c7.6-13.3,1.8-31.1-2.3-43.8C117.6,63.3,114.7,54.3,105.9,48.6Z" />
        <path fill="#2a1344" class="in-bottom" d="M102,67.1c-9.6-6.1-22-3.1-29.5,2-15.4,10.7-19.6,37.5-7.6,47.8s35.9,3.9,44.5-12.5C115.5,92.6,113.9,74.6,102,67.1Z" />
    </svg>

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="search-header mb-0"><i class="bi bi-cart-fill"></i> My Cart</h1>
            @if (Model != null && Model.Any())
            {
                <span class="cart-count-badge">@Model.Count item@(Model.Count > 1 ? "s" : "")</span>
            }
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="cart-empty">
                <i class="bi bi-cart-x"></i>
                <h3>Your cart is empty</h3>
                <p>Find an event to register for!</p>
                <a asp-controller="Search" asp-action="Index" class="dashboard-btn-custom" style="display:inline-flex; align-items:center; justify-content:center; text-decoration:none;">
                    <i class="bi bi-search me-2"></i> Browse Clubs
                </a>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-lg-8">
                    @foreach (var item in Model)
                    {
                        <div class="cart-item-card">
                            <div class="cart-item-image">
                                @if (!string.IsNullOrEmpty(item.Event?.ImageUrl))
                                {
                                    <img src="@item.Event.ImageUrl" alt="@item.Event.EventTitle" />
                                }
                                else
                                {
                                    <div class="cart-item-image-placeholder">
                                        <i class="bi bi-calendar-event"></i>
                                    </div>
                                }
                            </div>
                            <div class="cart-item-info">
                                <h5>@item.Event?.EventTitle</h5>
                                <p class="cart-item-club">@item.Event?.Club?.ClubName</p>
                                <p class="cart-item-meta"><i class="bi bi-calendar-event"></i> @item.Event?.EventDate.ToString("dd MMM yyyy h:mm tt")</p>
                                <p class="cart-item-meta"><i class="bi bi-geo-alt-fill"></i> @item.Event?.EventLocation</p>
                            </div>
                            <div class="cart-item-price-section">
                                <span class="cart-item-price">$@item.Event?.EntryFee</span>
                                <form action="/ShoppingCart/Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="cartId" value="@item.Id" />
                                    <button type="submit" class="cart-remove-btn"><i class="bi bi-trash3"></i></button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
                <div class="col-lg-4">
                    <div class="cart-summary-card">
                        <h4 class="cart-summary-title">Order Summary</h4>
                        <hr style="border-color: rgba(255,255,255,0.1);" />

                        <div class="cart-summary-row">
                            <span>Subtotal</span>
                            <span>$@total.ToString("0.00")</span>
                        </div>
                        <hr style="border-color: rgba(255,255,255,0.1);" />
                        <div class="cart-summary-row cart-summary-total">
                            <span>Total</span>
                            <span>$@total.ToString("0.00") NZD</span>
                        </div>

                        <form action="/ShoppingCart/Checkout" method="post" class="mt-4">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="cart-checkout-btn">
                                <i class="bi bi-lock-fill me-2"></i> Proceed to Checkout
                            </button>
                        </form>

                        <a asp-controller="Search" asp-action="Index" class="cart-continue-link">
                            <i class="bi bi-arrow-left"></i> Continue Browsing
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</body>