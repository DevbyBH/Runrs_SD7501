@model Runrs.Models.Club

@{
    ViewData["Title"] = "Create Club";
    ViewData["BodyClass"] = "home-page";
}

<body>
    <svg class="background-svg" preserveAspectRatio="xMidYMid slice" viewBox="10 10 80 80">
        <defs>
            <style>
                @@keyframes rotate {
                    0% {
                        transform: rotate(0deg);
                    }

                    100% {
                        transform: rotate(360deg);
                    }
                }

                .out-top {
                    animation: rotate 40s linear infinite;
                    transform-origin: 13px 25px;
                }

                .in-top {
                    animation: rotate 20s linear infinite;
                    transform-origin: 13px 25px;
                }

                .out-bottom {
                    animation: rotate 50s linear infinite;
                    transform-origin: 84px 93px;
                }

                .in-bottom {
                    animation: rotate 30s linear infinite;
                    transform-origin: 84px 93px;
                }
            </style>
        </defs>
        <path fill="#833AB4" class="out-top" d="M37-5C25.1-14.7,5.7-19.1-9.2-10-28.5,1.8-32.7,31.1-19.8,49c15.5,21.5,52.6,22,67.2,2.3C59.4,35,53.7,8.5,37-5Z" />
        <path fill="#2a1344" class="in-top" d="M20.6,4.1C11.6,1.5-1.9,2.5-8,11.2-16.3,23.1-8.2,45.6,7.4,50S42.1,38.9,41,24.5C40.2,14.1,29.4,6.6,20.6,4.1Z" />
        <path fill="#833AB4" class="out-bottom" d="M105.9,48.6c-12.4-8.2-29.3-4.8-39.4.8-23.4,12.8-37.7,51.9-19.1,74.1s63.9,15.3,76-5.6c7.6-13.3,1.8-31.1-2.3-43.8C117.6,63.3,114.7,54.3,105.9,48.6Z" />
        <path fill="#2a1344" class="in-bottom" d="M102,67.1c-9.6-6.1-22-3.1-29.5,2-15.4,10.7-19.6,37.5-7.6,47.8s35.9,3.9,44.5-12.5C115.5,92.6,113.9,74.6,102,67.1Z" />
    </svg>

    <div class="crud-form shadow border-0 mt-4">
        <div class="crud-card-header-box ml-0 py-3">
            <div class="crud-card-header">
                <h2 class="crud-header-text py-2">Create Club</h2>
                <p class="text-white">Start your own club and build your community. Add your club details here:</p>
            </div>
        </div>

        <div class="dashboard-card-body p-4">
            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="create-side-by-side-input mb-3">
                    <div>
                        <label asp-for="ClubName" class="crud-form-label"></label>
                        <input asp-for="ClubName" class="create-event-input" />
                        <span asp-validation-for="ClubName" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="ClubLocation" class="crud-form-label"></label>
                        <input asp-for="ClubLocation" class="create-event-input" />
                        <span asp-validation-for="ClubLocation" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ClubDescription" class="crud-form-label"></label>
                    <textarea asp-for="ClubDescription" class="create-event-textbox" rows="3"></textarea>
                    <span asp-validation-for="ClubDescription" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="crud-form-label">Club Image</label>
                    <input type="file" name="imageFile" class="form-control crud-input-border" accept="image/*" />
                    <small class="text-muted">Upload a club logo or image (max 5MB). Supported formats: JPG, PNG, GIF</small>
                </div>

                <div class="create-side-by-side-input mb-3">
                    <div>
                        <label asp-for="Difficulty" class="crud-form-label"></label>
                        <select asp-for="Difficulty"
                                asp-items="Html.GetEnumSelectList<Club.DifficultyLevel>()"
                                class="create-event-input">
                        </select>
                        <span asp-validation-for="Difficulty" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Distance" class="crud-form-label"></label>
                        <select asp-for="Distance"
                                asp-items="Html.GetEnumSelectList<Club.DistanceRange>()"
                                class="create-event-input">
                        </select>
                        <span asp-validation-for="Distance" class="text-danger"></span>
                    </div>
                </div>

                <div class="create-side-by-side-input mb-3">
                    <div>
                        <label asp-for="Type" class="crud-form-label"></label>
                        <select asp-for="Type"
                                asp-items="Html.GetEnumSelectList<Club.ClubType>()"
                                class="create-event-input">
                        </select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="IsPrivate" class="crud-form-label">Club Privacy</label>
                        <div class="event-type-toggle">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="isPrivateOption" id="publicClub" checked onchange="document.getElementById('IsPrivate').value='false'">
                                <label class="form-check-label text-white" for="publicClub">Public</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="isPrivateOption" id="privateClub" onchange="document.getElementById('IsPrivate').value='true'">
                                <label class="form-check-label text-white" for="privateClub">Private</label>
                            </div>
                        </div>
                        <input type="hidden" asp-for="IsPrivate" id="IsPrivate" value="false" />
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="create-btn">Create Club</button>
                    <a asp-controller="Club" asp-action="Index" class="create-cancel-btn"><i class="bi bi-x-circle"></i> Cancel</a>
                </div>

            </form>
        </div>
    </div>
</body>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}