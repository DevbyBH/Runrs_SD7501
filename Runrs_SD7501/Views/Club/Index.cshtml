@model List<Runrs_SD7501.Models.Club>

@{
    ViewData["Title"] = "My Clubs";
    ViewData["BodyClass"] = "home-page";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div>
    <div class="page-header">
        <h1 class="text-white py-2 mb-0 position-absolute start-50 translate-middle-x letter-spacing-lg">My Clubs</h1>
        <a asp-controller="Club" asp-action="Create" class="btn btn-custom">
            <i class="bi bi-plus-circle"></i> Create New Club
        </a>
    </div>
    <div class="card-body p-4">
        <div class="row pb-3">
        </div>

        @if (Model == null || !Model.Any())
        {
            <p class="text-muted text-center fw-bold">You have not joined or created any clubs yet.</p>
        }
        else
        {
            <div class="club-table-container"> <!-- Byron (18/04/2026) - Updated Table Layout w/ new Club Properties (Distance, Difficulty, Club Type)-->
                <table class="club-table">
                    <thead class="club-table-header">
                        <tr>
                            <th>Owner</th>
                            <th>Name</th>
                            <th>Location</th>
                            <th>Description</th>
                            <th>Private</th>
                            <th>Created On</th>
                            <th>Distance</th> <!-- Byron (18/04/2026) - Club Distance Header -->
                            <th>Difficulty</th> <!-- Byron (18/04/2026) - Club Difficulty Header -->
                            <th>Club Type</th> <!-- Byron (18/04/2026) - Club Type Header -->
                            <th>Edit/Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var club in Model.OrderBy(u => u.ClubName))
                        {
                            <tr>
                                <td>@club.Owner?.Username</td>
                                <td>@club.ClubName</td>
                                <td>@club.ClubLocation</td>
                                <td>@club.ClubDescription</td>
                                <td>@(club.IsPrivate ? "Yes" : "No")</td>
                                <td>@club.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>@Html.DisplayFor(modelItem => club.Distance)</td> <!-- Byron (18/04/2026) - Use DisplayFor()to read the Display Name of the property) -->
                                <td>@Html.DisplayFor(modelItem => club.Difficulty)</td> <!-- Byron (18/04/2026) - Use DisplayFor()to read the Display Name of the property) -->
                                <td>@Html.DisplayFor(modelItem => club.Type)</td> <!-- Byron (18/04/2026) - Use DisplayFor()to read the Display Name of the property) -->
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Club" asp-action="Edit" asp-route-id="@club.Id" class="btn crud-btn mx-1">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-controller="Club" asp-action="Delete" asp-route-id="@club.Id" class="btn crud-btn mx-1">
                                            <i class="bi bi-trash3-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>