@model List<Runrs_SD7501.Models.Club>

@{
    ViewData["Title"] = "My Clubs";
    ViewData["BodyClass"] = "home-page";
    var joinedClubs = ViewBag.JoinedClubs as List<Runrs_SD7501.Models.Club>;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div>
    <div class="page-header">
        <h1 class="text-white py-2 mb-0 position-absolute start-50 translate-middle-x letter-spacing-lg">My Clubs</h1>
        <a asp-controller="Club" asp-action="Create" class="btn btn-custom">
            <i class="bi bi-plus-circle"></i> Create New Club
        </a>
    </div>

    <div class="card-body p-4">

        <!-- OWNED CLUBS -->
        <h3 class="text-white mb-3">Owned Clubs</h3>
        @if (Model == null || !Model.Any())
        {
            <p class="text-muted text-center fw-bold">You have not created any clubs yet.</p>
        }
        else
        {
            <div class="club-table-container">
                <table class="club-table">
                    <thead class="club-table-header">
                        <tr>
                            <th>Owner</th>
                            <th>Name</th>
                            <th>Location</th>
                            <th>Description</th>
                            <th>Private</th>
                            <th>Created On</th>
                            <th>Distance</th>
                            <th>Difficulty</th>
                            <th>Club Type</th>
                            <th>Edit/Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var club in Model.OrderBy(u => u.ClubName))
                        {
                            <tr>
                                <td>@club.Owner?.Username</td>
                                <td>@club.ClubName</td>
                                <td>@club.ClubLocation</td>
                                <td>@club.ClubDescription</td>
                                <td>@(club.IsPrivate ? "Yes" : "No")</td>
                                <td>@club.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>@Html.DisplayFor(modelItem => club.Distance)</td>
                                <td>@Html.DisplayFor(modelItem => club.Difficulty)</td>
                                <td>@Html.DisplayFor(modelItem => club.Type)</td>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a asp-controller="Club" asp-action="Edit" asp-route-id="@club.Id" class="btn crud-btn mx-1">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>
                                        <a asp-controller="Club" asp-action="Delete" asp-route-id="@club.Id" class="btn crud-btn mx-1">
                                            <i class="bi bi-trash3-fill"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- JOINED CLUBS -->
        <h3 class="text-white mt-5 mb-3">Joined Clubs</h3>
        @if (joinedClubs == null || !joinedClubs.Any())
        {
            <p class="text-muted text-center fw-bold">You have not joined any clubs yet.</p>
        }
        else
        {
            <div class="club-table-container">
                <table class="club-table">
                    <thead class="club-table-header">
                        <tr>
                            <th>Owner</th>
                            <th>Name</th>
                            <th>Location</th>
                            <th>Description</th>
                            <th>Distance</th>
                            <th>Difficulty</th>
                            <th>Club Type</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var club in joinedClubs.OrderBy(u => u.ClubName))
                        {
                            <tr>
                                <td>@club.Owner?.Username</td>
                                <td>@club.ClubName</td>
                                <td>@club.ClubLocation</td>
                                <td>@club.ClubDescription</td>
                                <td>@Html.DisplayFor(modelItem => club.Distance)</td>
                                <td>@Html.DisplayFor(modelItem => club.Difficulty)</td>
                                <td>@Html.DisplayFor(modelItem => club.Type)</td>
                                <td>
                                    <a asp-controller="Club" asp-action="Details" asp-route-id="@club.Id" class="btn crud-btn mx-1">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

    </div>
</div>