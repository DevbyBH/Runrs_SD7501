@model Runrs_SD7501.Models.Club

@{
    var membership = ViewBag.Membership as Runrs_SD7501.Models.Membership;
    var userId = ViewBag.UserId as int? ?? 0;
    ViewData["Title"] = Model.ClubName;
    ViewData["BodyClass"] = "home-page";
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4 text-white">

    <!-- Title -->
    <h1>
        <span style="color:white">@Model.ClubName</span>
    </h1>

    <hr style="border-color:white;" />

    <p>
        <strong>Location:</strong> @Model.ClubLocation
    </p>

    <p>
        <strong>Description:</strong> @Model.ClubDescription
    </p>

    <p>
        <strong>Owner:</strong> @Model.Owner?.Username
    </p>

    <p>
        <strong>Type:</strong>
        <span style="color:#fe9144">@Model.Type</span>
    </p>

    <p>
        <strong>Difficulty:</strong>
        <span style="color:#fe9144">@Model.Difficulty</span>
    </p>

    <p>
        <strong>Distance:</strong> @Html.DisplayFor(modelItem => Model.Distance)
    </p>

    <hr style="border-color:white;" />

    <!-- Join Logic -->
    @if (Model.OwnerId == userId)
    {
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-secondary">You are the owner</span>

            <a asp-action="ManageRequests"
               asp-route-id="@Model.Id"
               class="btn btn-warning btn-sm">
                Manage Join Requests
            </a>
        </div>
    }
    else if (membership == null)
    {
        <form asp-action="Join" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn"
                    style="background-color: green; color:white;">
                Join Club
            </button>
        </form>
    }
    else if (membership.Status == Runrs_SD7501.Models.MembershipStatus.Pending)
    {
        <span class="badge" style="background-color:#ffc107; color:black;">
            Pending Approval
        </span>
    }
    else if (membership.Status == Runrs_SD7501.Models.MembershipStatus.Approved)
    {
        <div class="d-flex gap-2 align-items-center">
            <span class="badge" style="background-color:#28a745; color:white;">
                Member
            </span>
            <form asp-action="Leave" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger btn-sm">
                    <i class="bi bi-box-arrow-left"></i> Leave Club
                </button>
            </form>
        </div>
    }
    else
    {
        <span class="badge" style="background-color:#dc3545; color:white;">
            Rejected
        </span>
    }
    

    <br /><br />

    <a asp-action="Index"
       asp-controller="Search"
       class="btn btn-secondary">
        Back to Search
    </a>

</div>