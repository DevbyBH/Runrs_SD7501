@model Runrs.Models.Club

@{
    var membership = ViewBag.Membership as Runrs.Models.Membership;
    var userId = ViewBag.UserId as int? ?? 0;
    var members = ViewBag.Members as List<Runrs.Models.Membership>;

    ViewData["Title"] = Model.ClubName;
    ViewData["BodyClass"] = "home-page";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4 text-white">

    <!-- Title -->
    <h1>
        <span style="color:white">@Model.ClubName</span>
    </h1>

    <hr style="border-color:white;" />

    <p><strong>Location:</strong> @Model.ClubLocation</p>
    <p><strong>Description:</strong> @Model.ClubDescription</p>
    <p><strong>Owner:</strong> @Model.Owner?.Username</p>

    <p>
        <strong>Type:</strong>
        <span style="color:#fe9144">@Model.Type</span>
    </p>

    <p>
        <strong>Difficulty:</strong>
        <span style="color:#fe9144">@Model.Difficulty</span>
    </p>

    <p>
        <strong>Distance:</strong> @Html.DisplayFor(modelItem => Model.Distance)
    </p>

    <hr style="border-color:white;" />

    <!-- Join Logic -->
    @if (Model.OwnerId == userId)
    {
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-secondary">You are the owner</span>

            <a asp-action="ManageRequests"
               asp-route-id="@Model.Id"
               class="btn btn-warning btn-sm">
                Manage Join Requests
            </a>
        </div>
    }
    else if (membership == null)
    {
        <form asp-action="Join" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn"
                    style="background-color: green; color:white;">
                Join Club
            </button>
        </form>
    }
    else if (membership.Status == Runrs.Models.MembershipStatus.Pending)
    {
        <span class="badge" style="background-color:#ffc107; color:black;">
            Pending Approval
        </span>
    }
    else if (membership.Status == Runrs.Models.MembershipStatus.Approved)
    {
        <div class="d-flex gap-2 align-items-center">
            <span class="badge" style="background-color:#28a745; color:white;">
                Member
            </span>
            <form asp-action="Leave" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger btn-sm">
                    <i class="bi bi-box-arrow-left"></i> Leave Club
                </button>
            </form>
        </div>
    }
    else
    {
        <span class="badge" style="background-color:#dc3545; color:white;">
            Rejected
        </span>
    }

    <!-- ================= MEMBERS SECTION ================= -->

    <hr style="border-color:white;" />

    <h3 class="mt-4 mb-3">Club Members</h3>

    @if (members == null || !members.Any())
    {
        <p>No members yet.</p>
    }
    else
    {
        <div class="row">
            @foreach (var member in members)
            {
                <div class="col-md-4 mb-4">
                    <div class="club-card">

                        <!-- Placeholder -->
                        <div class="club-card-img-placeholder">
                            <i class="bi bi-person"></i>
                        </div>

                        <div class="club-card-body">

                            <h4 class="club-card-title">
                                @member.User?.Username
                            </h4>

                            <p class="club-card-description">
                                @member.User?.FirstName @member.User?.LastName
                            </p>

                            <div class="club-card-footer">

                                <!-- Owner Highlight -->
                                @if (member.UserId == Model.OwnerId)
                                {
                                    <span class="club-badge bg-primary">
                                        Owner
                                    </span>
                                }
                                else
                                {
                                    <span class="club-badge bg-success">
                                        Member
                                    </span>
                                }

                                <!-- Admin Role -->
                                @if (member.Role == "Admin")
                                {
                                    <span class="club-badge bg-warning text-dark">
                                        Admin
                                    </span>
                                }

                            </div>

                            <p class="club-card-location mt-2">
                                <i class="bi bi-calendar"></i>
                                Joined: @member.JoinedAt.ToString("dd/MM/yyyy")
                            </p>

                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @{
        var events = ViewBag.Events as List<Runrs.Models.RunEvent>;
    }

    <hr style="border-color:white;" />

    <!-- Events Carousel -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-white mb-0">Upcoming Events</h3>
        @if (Model.OwnerId == userId)
        {
            <a asp-controller="Event" asp-action="Create"
               asp-route-clubId="@Model.Id" class="btn btn-custom btn-sm">
                <i class="bi bi-plus-circle"></i> Create Event
            </a>
        }
    </div>

    @if (events == null || !events.Any())
    {
        <p class="text-muted">No upcoming events scheduled.</p>
    }
    else
    {
        <div id="eventsCarousel" class="carousel slide mb-4" data-bs-ride="carousel">

            <!-- Indicators -->
            <div class="carousel-indicators">
                @for (int i = 0; i < events.Count; i++)
                {
                    <button type="button"
                            data-bs-target="#eventsCarousel"
                            data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")"
                            aria-label="Event @(i + 1)">
                    </button>
                }
            </div>

            <!-- Carousel Items -->
            <div class="carousel-inner">
                @for (int i = 0; i < events.Count; i++)
                {
                    var ev = events[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="event-carousel-card">
                            <div class="event-carousel-body">
                                <h4 class="event-carousel-title">@ev.EventTitle</h4>
                                <p class="event-carousel-info">
                                    <i class="bi bi-calendar-event"></i>
                                    @ev.EventDate.ToString("dd MMM yyyy h:mm tt")
                                </p>
                                <p class="event-carousel-info">
                                    <i class="bi bi-geo-alt-fill"></i>
                                    @ev.EventLocation
                                </p>
                                <p class="event-carousel-desc">@ev.EventDescription</p>
                                <div class="d-flex gap-2 flex-wrap mt-3">
                                    <span class="club-badge">
                                        <i class="bi bi-signpost-2"></i> @ev.Distance km
                                    </span>
                                    <span class="club-badge">
                                        <i class="bi bi-people-fill"></i> @ev.MaxParticipants spots
                                    </span>
                                    <span class="club-badge">
                                        @(ev.EntryFee == 0 ? "Free" : $"${ev.EntryFee}")
                                    </span>
                                </div>
                                <a asp-controller="Event" asp-action="Details"
                                   asp-route-id="@ev.Id"
                                   class="btn btn-custom mt-3">
                                    View Event
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Controls -->
            @if (events.Count > 1)
            {
                <button class="carousel-control-prev" type="button"
                        data-bs-target="#eventsCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button"
                        data-bs-target="#eventsCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            }
        </div>
    }

    <!-- ================= END MEMBERS ================= -->

    <br /><br />

    <a asp-action="Index"
       asp-controller="Search"
       class="btn btn-secondary">
        Back to Search
    </a>

</div>