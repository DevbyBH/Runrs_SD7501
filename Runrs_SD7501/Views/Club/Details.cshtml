@model Runrs.Models.Club

@{
    var membership = ViewBag.Membership as Runrs.Models.Membership;
    var userId = ViewBag.UserId as int? ?? 0;
    var members = ViewBag.Members as List<Runrs.Models.Membership>;
    var announcements = ViewBag.Announcements as List<Runrs.Models.Announcement>;

    ViewData["Title"] = Model.ClubName;
    ViewData["BodyClass"] = "home-page";
}

<body>

    <svg class="background-svg" preserveAspectRatio="xMidYMid slice" viewBox="10 10 80 80">
        <defs>
            <style>
                @@keyframes rotate {
                    0% {
                        transform: rotate(0deg);
                    }

                    100% {
                        transform: rotate(360deg);
                    }
                }

                .out-top {
                    animation: rotate 40s linear infinite;
                    transform-origin: 13px 25px;
                }

                .in-top {
                    animation: rotate 20s linear infinite;
                    transform-origin: 13px 25px;
                }

                .out-bottom {
                    animation: rotate 50s linear infinite;
                    transform-origin: 84px 93px;
                }

                .in-bottom {
                    animation: rotate 30s linear infinite;
                    transform-origin: 84px 93px;
                }
            </style>
        </defs>
        <path fill="#833AB4" class="out-top" d="M37-5C25.1-14.7,5.7-19.1-9.2-10-28.5,1.8-32.7,31.1-19.8,49c15.5,21.5,52.6,22,67.2,2.3C59.4,35,53.7,8.5,37-5Z" />
        <path fill="#2a1344" class="in-top" d="M20.6,4.1C11.6,1.5-1.9,2.5-8,11.2-16.3,23.1-8.2,45.6,7.4,50S42.1,38.9,41,24.5C40.2,14.1,29.4,6.6,20.6,4.1Z" />
        <path fill="#833AB4" class="out-bottom" d="M105.9,48.6c-12.4-8.2-29.3-4.8-39.4.8-23.4,12.8-37.7,51.9-19.1,74.1s63.9,15.3,76-5.6c7.6-13.3,1.8-31.1-2.3-43.8C117.6,63.3,114.7,54.3,105.9,48.6Z" />
        <path fill="#2a1344" class="in-bottom" d="M102,67.1c-9.6-6.1-22-3.1-29.5,2-15.4,10.7-19.6,37.5-7.6,47.8s35.9,3.9,44.5-12.5C115.5,92.6,113.9,74.6,102,67.1Z" />
    </svg>

    <a asp-action="Index" asp-controller="Search" class="btn rounded-circle club-back-button" title="Back to Search">
        <i class="bi bi-arrow-left fs-5"></i>
    </a>

    <!-- Club Cover Image Section - Byron 24/05/2026 -->
    <div class="club-cover-section" @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <text>style="background-image: linear-gradient(rgba(82, 36, 87, 0.32), rgba(144, 73, 163, 1)), url('@Model.ImageUrl');"</text>
    }
    else
    {
        <text>style="background-image: linear-gradient(135deg, #833AB4, #2a1344);"</text>
    }>
        <div class="container">
            <div class="cover-top-bar">
                @if (Model.OwnerId == userId)
                {
                        <div class="d-flex gap-2 align-items-center">
                            <span class="owner-badge">Club Owner <i class="bi bi-star-fill" style="color: gold;"></i></span>
                            <a asp-action="ManageRequests" asp-route-id="@Model.Id" class="manage-join-btn">Manage Join Requests</a>
                        </div>
                }
                else if (membership == null)
                {
                        <form asp-action="Join" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                            <button type="submit" class="join-btn-custom"><i class="bi bi-box-arrow-in-right"></i> Join Club</button>
                        </form>
                }
                else if (membership.Status == Runrs.Models.MembershipStatus.Pending)
                {
                        <span class="badge fs-6" style="background-color:#ffc107; color:black; padding: 10px 20px;">Pending Approval</span>
                }
                else if (membership.Status == Runrs.Models.MembershipStatus.Approved)
                {
                        <div class="d-flex gap-2 align-items-center">
                            <span class="member-badge" style="background-color:#28a745; color:white;"><i class="bi bi-person-check-fill"></i> Member</span>
                            <form asp-action="Leave" asp-route-id="@Model.Id" method="post">
                            @Html.AntiForgeryToken()
                                <button type="submit" class="leave-club-btn"><i class="bi bi-box-arrow-left"></i> Leave</button>
                            </form>
                        </div>
                }
                else
                {
                        <span class="badge fs-6" style="background-color:#dc3545; color:white; padding: 10px 20px;">
                            Rejected
                        </span>
                }
            </div>

            <!-- Club Name -->
            <div class="cover-title-section">
                <h1 class="cover-club-name">@Model.ClubName</h1>
            </div>

            <div class="cover-stats-row">
                <div class="club-stat-card">
                    <div class="stat-icon">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <div class="stat-info">
                        <p class="stat-label">Location:</p>
                        <h3 class="stat-value">@Model.ClubLocation</h3>
                    </div>
                </div>
                <div class="club-stat-card">
                    <div class="stat-icon">
                        <i class="bi bi-person-walking"></i>
                    </div>
                    <div class="stat-info">
                        <p class="stat-label">Club Type:</p>
                        <h3 class="stat-value">@Model.Type Club</h3>
                    </div>
                </div>
                <div class="club-stat-card">
                    <div class="stat-icon">
                        <i class="bi bi-bar-chart-line-fill"></i>
                    </div>
                    <div class="stat-info">
                        <p class="stat-label">Difficulty:</p>
                        <h3 class="stat-value">@Model.Difficulty</h3>
                    </div>
                </div>
                <div class="club-stat-card">
                    <div class="stat-icon">
                        <i class="bi bi-speedometer"></i>
                    </div>
                    <div class="stat-info">
                        <p class="stat-label">AVG Run Distances:</p>
                        <h3 class="stat-value">@Html.DisplayFor(modelItem => Model.Distance)</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container mt-5 pt-3 text-white">
        <hr style="color:transparent;"/>

        <!-- Announcement / Newsfeed Section -->
        <div class="text-center mb-3">
            <h3 class="text-white mb-0"><i class="bi bi-megaphone"></i> Announcements</h3>
        </div>

        @if (Model.OwnerId == userId)
        {
            <form action="/Club/PostAnnouncement" method="post" class="mb-4">
                @Html.AntiForgeryToken()
                <input type="hidden" name="clubId" value="@Model.Id" />
                <div class="announcement-editor-wrapper">
                    <textarea id="announcementContent" name="content" class="create-event-textbox" rows="3"></textarea>
                    <div class="post-btn-wrapper">
                        <button type="submit" class="post-announcement-btn">Post Announcement</button>
                    </div>
                </div>
            </form>
        }

        @if (announcements == null || !announcements.Any())
        {
            <p style="text-align: center; color: dimgray; font-weight: bolder;"> No Announcements Yet! </p>
        }
        else
        {
            @foreach (var announcement in announcements)
            {
                <div class="announcement-card mb-3">
                    <div class="announcement-header">
                        <span class="announcement-author">
                            <i class="bi bi-person-fill"></i>
                            @announcement.PostedBy?.Username
                        </span>
                        <span class="announcement-date">
                            @announcement.CreatedDate.ToString("dd MMM yyyy h:mm tt")
                        </span>
                    </div>
                    <div class="announcement-content">@Html.Raw(announcement.Content)</div>
                    @if (Model.OwnerId == userId)
                    {
                        <form id="deleteAnnouncementForm-@announcement.Id" action="/Club/DeleteAnnouncement" method="post" style="display:none;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="announcementId" value="@announcement.Id" />
                            <input type="hidden" name="clubId" value="@Model.Id" />
                        </form>
                        <button type="button" class="delete-announcement-btn" onclick="confirmDeleteAnnouncement(@announcement.Id)"><i class="bi bi-trash3-fill"></i></button>
                    }
                </div>
            }
        }

        <hr style="color: transparent; margin-top: 40px;"/>

        <!-- Members Section -->
        <h3 class="mt-4 mb-5" style="text-align: center;">
            <i class="bi bi-people-fill"></i> Club Members
        </h3>

        @if (members == null || !members.Any())
        {
            <p style="text-align: center; color: dimgray; font-weight: bolder;">No members yet.</p>
        }
        else
        {
            <div class="members-scroll-container">
                <div class="members-scroll-track">
                    @foreach (var member in members)
                    {
                        <div class="member-scroll-item">
                            <div class="club-member-card">
                                @if (!string.IsNullOrEmpty(member.User?.ProfileImageUrl))
                                {
                                    <div class="club-member-image-container">
                                        <a asp-controller="Profile" asp-action="Details" asp-route-id="@member.UserId">
                                            <img src="@member.User.ProfileImageUrl" alt="@member.User.Username" class="club-member-image" />
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <a asp-controller="Profile" asp-action="Details" asp-route-id="@member.UserId">
                                        <div class="club-member-placeholder">
                                            <i class="bi bi-person"></i>
                                        </div>
                                    </a>
                                }
                                <h4 class="club-member-title">@member.User?.Username</h4>
                                @if (member.UserId == Model.OwnerId)
                                {
                                    <div class="club-member-role">
                                        <span class="badge bg-primary">Owner</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @{
            var events = ViewBag.Events as List<Runrs.Models.RunEvent>;
        }

        <hr style="color: transparent; margin-top: 30px; margin-bottom: 60px;" />

        <!-- Events Carousel -->
        <div class="event-top-container">
            <h3 class="text-white mb-0 position-absolute start-50 translate-middle-x pb-5 pt-3"><i class="bi bi-calendar-fill"></i> Upcoming Events</h3>
            @if (Model.OwnerId == userId)
            {
                <div class="ms-auto">
                    <a asp-controller="Event" asp-action="Create" asp-route-clubId="@Model.Id" class="create-event-btn"><i class="bi bi-plus-circle"></i> Create Event</a>
                </div>
            }
        </div>

        @if (events == null || !events.Any())
        {
            <p style="text-align: center; color: dimgray; font-weight: bolder;">No upcoming events scheduled.</p>
        }
        else
        {
            <div id="eventsCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    @for (int i = 0; i < events.Count; i++)
                    {
                        <button type="button" data-bs-target="#eventsCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="Event @(i + 1)"></button>
                    }
                </div>
                <div class="carousel-inner">
                    @for (int i = 0; i < events.Count; i++)
                    {
                        var ev = events[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="event-carousel-card">
                                <div class="event-carousel-body">
                                    <h4 class="event-carousel-title">@ev.EventTitle</h4>
                                    <div class="carousel-side-by-side">
                                        <p class="carousel-info-card"><i class="bi bi-calendar-event"></i> @ev.EventDate.ToString("dd MMM yyyy h:mm tt")</p>
                                        <p class="carousel-info-card"><i class="bi bi-geo-alt-fill"></i> @ev.EventLocation</p>
                                    </div>
                                    <p class="event-carousel-desc">@ev.EventDescription</p>
                                    <div class="d-flex gap-2 flex-wrap mt-3">
                                        <div class="event-carousel-badge">
                                            <span class="club-badge"><i class="bi bi-signpost-2"></i> @ev.Distance km</span>
                                            <span class="club-badge"><i class="bi bi-people-fill"></i> @ev.MaxParticipants spots</span>
                                            <span class="club-badge">@(ev.EntryFee == 0 ? "Free" : $"${ev.EntryFee}")</span>
                                        </div>
                                    </div>
                                    <button class="dashboard-btn-custom view-event-btn" style="margin-top: 20px;" data-event-id="@ev.Id">View Event</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (events.Count > 1)
                {
                    <button class="carousel-control-prev" type="button" data-bs-target="#eventsCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon"></span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#eventsCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon"></span>
                    </button>
                }
            </div>
        }
    </div>
    <div id="eventModalContainer"></div>
</body>