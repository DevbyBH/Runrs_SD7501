@{
    ViewData["Title"] = "Home Page";
    ViewData["BodyClass"] = "home-page";
}

@using Runrs.Models
@using Runrs.Models.ViewModels

<body>
    <svg class="background-svg" preserveAspectRatio="xMidYMid slice" viewBox="10 10 80 80">
        <defs>
            <style>
                @@keyframes rotate {
                    0% {
                        transform: rotate(0deg);
                    }

                    100% {
                        transform: rotate(360deg);
                    }
                }

                .out-top {
                    animation: rotate 40s linear infinite;
                    transform-origin: 13px 25px;
                }

                .in-top {
                    animation: rotate 20s linear infinite;
                    transform-origin: 13px 25px;
                }

                .out-bottom {
                    animation: rotate 50s linear infinite;
                    transform-origin: 84px 93px;
                }

                .in-bottom {
                    animation: rotate 30s linear infinite;
                    transform-origin: 84px 93px;
                }
            </style>
        </defs>
        <path fill="#833AB4" class="out-top" d="M37-5C25.1-14.7,5.7-19.1-9.2-10-28.5,1.8-32.7,31.1-19.8,49c15.5,21.5,52.6,22,67.2,2.3C59.4,35,53.7,8.5,37-5Z" />
        <path fill="#2a1344" class="in-top" d="M20.6,4.1C11.6,1.5-1.9,2.5-8,11.2-16.3,23.1-8.2,45.6,7.4,50S42.1,38.9,41,24.5C40.2,14.1,29.4,6.6,20.6,4.1Z" />
        <path fill="#833AB4" class="out-bottom" d="M105.9,48.6c-12.4-8.2-29.3-4.8-39.4.8-23.4,12.8-37.7,51.9-19.1,74.1s63.9,15.3,76-5.6c7.6-13.3,1.8-31.1-2.3-43.8C117.6,63.3,114.7,54.3,105.9,48.6Z" />
        <path fill="#2a1344" class="in-bottom" d="M102,67.1c-9.6-6.1-22-3.1-29.5,2-15.4,10.7-19.6,37.5-7.6,47.8s35.9,3.9,44.5-12.5C115.5,92.6,113.9,74.6,102,67.1Z" />
    </svg>

    <!-- New Dashboard Feature (User-specific) Byron (18/05/2026) -->
    <div class="dashboard-container">
        <div class="dashboard-header">
            <h1 class="dashboard-title">Dashboard</h1>
        </div>
        <div class="dashboard-stats-row">
            <div class="dashboard-stat-card">
                <div class="stat-icon">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="stat-info">
                    <h3 class="stat-value">@ViewBag.ClubCount</h3>
                    <p class="stat-label">My Clubs</p>
                </div>
            </div>
            <div class="dashboard-stat-card">
                <div class="stat-icon">
                    <i class="bi bi-calendar-event-fill"></i>
                </div>
                <div class="stat-info">
                    <h3 class="stat-value">@ViewBag.ThisWeekRuns</h3>
                    <p class="stat-label">Runs This Week</p>
                </div>
            </div>
            <div class="dashboard-stat-card">
                <div class="stat-icon">
                    <i class="bi bi-flag-fill"></i>
                </div>
                <div class="stat-info">
                    @{
                        var upcomingEvents = ViewBag.UpcomingEvents as List<RunEvent>;
                        var nextEventDays = "N/A";
                        if (upcomingEvents != null && upcomingEvents.Any())
                        {
                            var days = (upcomingEvents.First().EventDate - DateTime.Now).Days;
                            nextEventDays = days == 0 ? "Today!" : $"{days} Days";
                        }
                    }
                    <h3 class="stat-value">@nextEventDays</h3>
                    <p class="stat-label">Next Event</p>
                </div>
            </div>
        </div>

        <div class="dashboard-content-row">
            <!-- Left Column - Byron (18/05/2026) -->
            <div class="dashboard-left-col">

                <!-- Upcoming Events - Byron (18/05/2026) -->
                <div class="dashboard-card">
                    <div class="dashboard-card-header">
                        <h3><i class="bi bi-calendar-check"></i> Upcoming Events</h3>
                    </div>
                    <div class="dashboard-card-body">
                        @if (upcomingEvents != null && upcomingEvents.Any())
                        {
                            foreach (var evt in upcomingEvents)
                            {
                                var daysUntil = (evt.EventDate - DateTime.Now).Days;
                                var dayLabel = daysUntil == 0 ? "Today" : daysUntil == 1 ? "Tomorrow" : $"{daysUntil} days";

                                <div class="dashboard-event-item">
                                    <div class="event-date-badge">
                                        <span class="event-date-day">@evt.EventDate.ToString("dd")</span>
                                        <span class="event-date-month">@evt.EventDate.ToString("MMM")</span>
                                    </div>
                                    <div class="event-info">
                                        <h4>@evt.EventTitle</h4>
                                        <p class="event-club"><i class="bi bi-geo-alt-fill"></i> @evt.EventLocation</p>
                                        <p class="event-meta">@evt.Club?.ClubName • @evt.Distance km • @dayLabel</p>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="dashboard-empty">
                                <p>No upcoming events!</p>
                                <a asp-controller="Search" asp-action="Index" class="dashboard-btn-custom-lg">Find Clubs</a>
                            </div>
                        }
                    </div>
                </div>

                <!-- My Clubs - Byron (18/05/2026) -->
                <div class="dashboard-card">
                    <div class="dashboard-card-header">
                        <h3><i class="bi bi-people-fill"></i> My Clubs</h3>
                    </div>
                    <div class="dashboard-card-body">
                        @{
                            var myClubs = ViewBag.MyClubs as List<Club>;
                        }
                        @if (myClubs != null && myClubs.Any())
                        {
                            <div class="dashboard-clubs-grid">
                                @foreach (var club in myClubs.Take(4))
                                {
                                    <a asp-controller="Club" asp-action="Details" asp-route-id="@club.Id" class="dashboard-club-chip">
                                        @if (!string.IsNullOrEmpty(club.ImageUrl))
                                        {
                                            <img src="@club.ImageUrl" alt="@club.ClubName" class="club-chip-img" />
                                        }
                                        else
                                        {
                                            <div class="club-chip-placeholder">
                                                <i class="bi bi-people-fill"></i>
                                            </div>
                                        }
                                        <span class="club-chip-name">@club.ClubName</span>
                                    </a>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="dashboard-empty">
                                <p>You haven't joined any clubs yet!</p>
                                <a asp-controller="Search" asp-action="Index" class="dashboard-btn-custom-lg">Discover Clubs</a>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column - Byron (18/05/2026) -->
            <div class="dashboard-right-col">

                <!-- Suggested Clubs - Byron (18/05/2026) -->
                <div class="dashboard-card">
                    <div class="dashboard-card-header">
                        <h3><i class="bi bi-lightbulb-fill"></i> Suggested Clubs</h3>
                    </div>
                    <div class="dashboard-card-body">
                        @{
                            var suggestedClubs = ViewBag.SuggestedClubs as List<Club>;
                        }
                        @if (suggestedClubs != null && suggestedClubs.Any())
                        {
                            foreach (var club in suggestedClubs)
                            {
                                <div class="dashboard-suggested-item">
                                    @if (!string.IsNullOrEmpty(club.ImageUrl))
                                    {
                                        <img src="@club.ImageUrl" alt="@club.ClubName" class="suggested-img" />
                                    }
                                    else
                                    {
                                        <div class="suggested-img-placeholder">
                                            <i class="bi bi-people-fill"></i>
                                        </div>
                                    }
                                    <div class="suggested-info">
                                        <h4>@club.ClubName</h4>
                                        <p><i class="bi bi-geo-alt-fill"></i> @club.ClubLocation</p>
                                    </div>
                                    <a asp-controller="Club" asp-action="Details" asp-route-id="@club.Id" class="dashboard-btn-custom" style="width:auto; padding:5px 15px; font-size:12px;">View</a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="dashboard-empty">
                                <p>No suggestions available right now.</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Recent Activity - Byron (27/05/2026) -->
                <div class="dashboard-card">
                    <div class="dashboard-card-header">
                        <h3><i class="bi bi-clock-history"></i> Recent Activity</h3>
                    </div>

                    <div class="dashboard-card-body">

                        @{
                            var recentActivity = ViewBag.RecentActivity as List<ActivityItem>;
                        }

                        @if (recentActivity != null && recentActivity.Any())
                        {
                            foreach (var activity in recentActivity)
                            {
                                var badgeClass = activity.Type switch
                                {
                                    "success" => "activity-badge-success", "request" => "activity-badge-request", "warning" => "activity-badge-warning", "info" => "activity-badge-info", _ => "activity-badge-default"
                                };

                                var badgeIcon = activity.Type switch
                                {
                                    "success" => "bi-check-lg", "request" => "bi-person-plus", "warning" => "bi-hourglass-split", "info" => "bi-people", _ => "bi-bell"
                                };

                                var badgeLabel = activity.Type switch
                                {
                                    "request" => "Request",
                                    _ => activity.Type.ToUpper()
                                };

                                <a href="@activity.Url" class="text-decoration-none text-white">
                                    <div class="activity-feed-item">
                                        <div class="activity-icon-container @badgeClass">
                                            <i class="bi @badgeIcon"></i>
                                        </div>
                                        <div class="activity-feed-content">
                                            <p class="activity-feed-message">@activity.Message</p>
                                            <span class="activity-feed-time">@activity.Date.ToString("dd MMM yyyy")</span>
                                        </div>
                                    </div>
                                </a>
                            }
                        }
                        else
                        {
                            <div class="dashboard-empty">
                                <p>No recent activity.</p>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</body>