@model List<Runrs.Models.Club>

@{
    ViewData["Title"] = "Search";
    ViewData["BodyClass"] = "home-page";

    var memberships = ViewBag.Memberships as List<Runrs.Models.Membership>;
    var memberCounts = ViewBag.MemberCounts as Dictionary<int, int>;
    var userId = Context.Session.GetInt32("UserId") ?? 0;
}

<body>
    <svg class="background-svg" preserveAspectRatio="xMidYMid slice" viewBox="10 10 80 80">
        <defs>
            <style>
                @@keyframes rotate {
                    0% {
                        transform: rotate(0deg);
                    }

                    100% {
                        transform: rotate(360deg);
                    }
                }

                .out-top {
                    animation: rotate 40s linear infinite;
                    transform-origin: 13px 25px;
                }

                .in-top {
                    animation: rotate 20s linear infinite;
                    transform-origin: 13px 25px;
                }

                .out-bottom {
                    animation: rotate 50s linear infinite;
                    transform-origin: 84px 93px;
                }

                .in-bottom {
                    animation: rotate 30s linear infinite;
                    transform-origin: 84px 93px;
                }
            </style>
        </defs>
        <path fill="#833AB4" class="out-top" d="M37-5C25.1-14.7,5.7-19.1-9.2-10-28.5,1.8-32.7,31.1-19.8,49c15.5,21.5,52.6,22,67.2,2.3C59.4,35,53.7,8.5,37-5Z" />
        <path fill="#2a1344" class="in-top" d="M20.6,4.1C11.6,1.5-1.9,2.5-8,11.2-16.3,23.1-8.2,45.6,7.4,50S42.1,38.9,41,24.5C40.2,14.1,29.4,6.6,20.6,4.1Z" />
        <path fill="#833AB4" class="out-bottom" d="M105.9,48.6c-12.4-8.2-29.3-4.8-39.4.8-23.4,12.8-37.7,51.9-19.1,74.1s63.9,15.3,76-5.6c7.6-13.3,1.8-31.1-2.3-43.8C117.6,63.3,114.7,54.3,105.9,48.6Z" />
        <path fill="#2a1344" class="in-bottom" d="M102,67.1c-9.6-6.1-22-3.1-29.5,2-15.4,10.7-19.6,37.5-7.6,47.8s35.9,3.9,44.5-12.5C115.5,92.6,113.9,74.6,102,67.1Z" />
    </svg>

    <div class="search-container">
        <h1 class="search-header">Find Run Clubs</h1>

        <form method="get" asp-controller="Search" asp-action="Index" class="d-flex gap-2 mb-4">
            <input type="text" name="query" placeholder="Search clubs..."
                   class="search-bar"
                   value="@Context.Request.Query["query"]" />
            <button type="submit" class="btn search-btn">
                <i class="bi bi-search"></i> Search
            </button>
        </form>

        @if (Model == null || !Model.Any())
        {
            <p class="text-white text-center fw-bold">No clubs found.</p>
        }
        else
        {
            <div class="row">
                @foreach (var club in Model)
                {
                    var membership = memberships?.FirstOrDefault(m => m.ClubId == club.Id);

                    <div class="col-md-4 mb-4">
                        <div class="club-card">

                            @if (!string.IsNullOrEmpty(club.ImageUrl))
                            {
                                <img src="@club.ImageUrl" class="club-card-img" alt="@club.ClubName" />
                            }
                            else
                            {
                                <div class="club-card-img-placeholder">
                                    <i class="bi bi-person-running"></i>
                                </div>
                            }

                        <div class="club-card-body">
                            <h3 class="club-card-title">@club.ClubName</h3>

                            <p class="club-card-location">
                                <i class="bi bi-geo-alt-fill"></i> @club.ClubLocation
                            </p>

                            <p class="club-card-description">
                                @club.ClubDescription
                            </p>

                            <div class="club-card-footer mb-2">

                                <span class="club-badge">
                                    @(club.IsPrivate ? "Private" : "Public")
                                </span>

                                <span class="club-badge">
                                    @club.Difficulty
                                </span>

                                <span class="club-badge">
                                    @Html.DisplayFor(modelItem => club.Distance)
                                </span>

                                <span class="club-badge">
                                    @club.Type
                                </span>

                                <!-- MEMBER COUNT -->
                                <span class="club-badge">
                                    <i class="bi bi-people-fill"></i>
                                    @(memberCounts != null && memberCounts.ContainsKey(club.Id)
                                                                ? memberCounts[club.Id]
                                                                : 0)
                            </span>

                                </div>

                                <!-- BUTTON SECTION -->
                                <div class="d-flex justify-content-between align-items-center mt-3">

                                    <!-- View Details -->
                                    <a asp-controller="Club" asp-action="Details" asp-route-id="@club.Id"class="btn card-btn">
                                        View Details
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</body>