@model List<Runrs_SD7501.Models.Club>

@{
    ViewData["Title"] = "Search";
    ViewData["BodyClass"] = "home-page";

    var memberships = ViewBag.Memberships as List<Runrs_SD7501.Models.Membership>;
    var memberCounts = ViewBag.MemberCounts as Dictionary<int, int>;
    var userId = Context.Session.GetInt32("UserId") ?? 0;
}

<div class="search-container">
    <h1 class="search-header">Find Run Clubs</h1>

    <form method="get" asp-controller="Search" asp-action="Index" class="d-flex gap-2 mb-4">
        <input type="text" name="query" placeholder="Search clubs..."
               class="search-bar"
               value="@Context.Request.Query["query"]" />
        <button type="submit" class="btn search-btn">
            <i class="bi bi-search"></i> Search
        </button>
    </form>

    @if (Model == null || !Model.Any())
    {
        <p class="text-white text-center fw-bold">No clubs found.</p>
    }
    else
    {
        <div class="row">
            @foreach (var club in Model)
            {
                var membership = memberships?.FirstOrDefault(m => m.ClubId == club.Id);

                <div class="col-md-4 mb-4">
                    <div class="club-card">

                        @if (!string.IsNullOrEmpty(club.ImageUrl))
                        {
                            <img src="@club.ImageUrl" class="club-card-img" alt="@club.ClubName" />
                        }
                        else
                        {
                            <div class="club-card-img-placeholder">
                                <i class="bi bi-person-running"></i>
                            </div>
                        }

                    <div class="club-card-body">
                        <h3 class="club-card-title">@club.ClubName</h3>

                        <p class="club-card-location">
                            <i class="bi bi-geo-alt-fill"></i> @club.ClubLocation
                        </p>

                        <p class="club-card-description">
                            @club.ClubDescription
                        </p>

                        <div class="club-card-footer mb-2">

                            <span class="club-badge">
                                @(club.IsPrivate ? "Private" : "Public")
                            </span>

                            <span class="club-badge">
                                @club.Difficulty
                            </span>

                            <span class="club-badge">
                                @Html.DisplayFor(modelItem => club.Distance)
                            </span>

                            <span class="club-badge">
                                @club.Type
                            </span>

                            <!-- MEMBER COUNT -->
                            <span class="club-badge">
                                <i class="bi bi-people-fill"></i>
                                @(memberCounts != null && memberCounts.ContainsKey(club.Id)
                                                            ? memberCounts[club.Id]
                                                            : 0)
                        </span>

                            </div>

                            <!-- BUTTON SECTION -->
                            <div class="d-flex justify-content-between align-items-center mt-3">

                                <!-- View Details -->
                                <a asp-controller="Club"
                                   asp-action="Details"
                                   asp-route-id="@club.Id"
                                   class="btn card-btn">
                                    View Details
                                </a>

                                <!-- Membership Logic -->
                        @if (club.OwnerId == userId)
                                {
                                    <span class="badge bg-secondary">Owner</span>
                                }
                                else if (membership == null)
                                {
                                    <form asp-controller="Club"
                                          asp-action="Join"
                                          asp-route-id="@club.Id"
                                          method="post">
                                        <button type="submit" class="btn btn-sm btn-success">
                                            Join
                                        </button>
                                    </form>
                                }
                                else if (membership.Status == Runrs_SD7501.Models.MembershipStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (membership.Status == Runrs_SD7501.Models.MembershipStatus.Approved)
                                {
                                    <span class="badge bg-success">Member</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Rejected</span>
                                }

                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>