@model Runrs.Models.User

@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <link href="@Url.Content("~/css/site.css")" rel="stylesheet" />
    <title>Login</title>
</head>

<body class="login-body">
    <svg class="background-svg" preserveAspectRatio="xMidYMid slice" viewBox="10 10 80 80">
        <defs>
            <style>
                @@keyframes rotate {
                    0% {
                        transform: rotate(0deg);
                    }

                    100% {
                        transform: rotate(360deg);
                    }
                }

                .out-top {
                    animation: rotate 20s linear infinite;
                    transform-origin: 13px 25px;
                }

                .in-top {
                    animation: rotate 10s linear infinite;
                    transform-origin: 13px 25px;
                }

                .out-bottom {
                    animation: rotate 25s linear infinite;
                    transform-origin: 84px 93px;
                }

                .in-bottom {
                    animation: rotate 15s linear infinite;
                    transform-origin: 84px 93px;
                }
            </style>
        </defs>
        <path fill="#833AB4" class="out-top" d="M37-5C25.1-14.7,5.7-19.1-9.2-10-28.5,1.8-32.7,31.1-19.8,49c15.5,21.5,52.6,22,67.2,2.3C59.4,35,53.7,8.5,37-5Z" />
        <path fill="#2a1344" class="in-top" d="M20.6,4.1C11.6,1.5-1.9,2.5-8,11.2-16.3,23.1-8.2,45.6,7.4,50S42.1,38.9,41,24.5C40.2,14.1,29.4,6.6,20.6,4.1Z" />
        <path fill="#833AB4" class="out-bottom" d="M105.9,48.6c-12.4-8.2-29.3-4.8-39.4.8-23.4,12.8-37.7,51.9-19.1,74.1s63.9,15.3,76-5.6c7.6-13.3,1.8-31.1-2.3-43.8C117.6,63.3,114.7,54.3,105.9,48.6Z" />
        <path fill="#2a1344" class="in-bottom" d="M102,67.1c-9.6-6.1-22-3.1-29.5,2-15.4,10.7-19.6,37.5-7.6,47.8s35.9,3.9,44.5-12.5C115.5,92.6,113.9,74.6,102,67.1Z" />
    </svg>

    <div class="login-main-container">
        <div class="login-card">
            <h2 class="login-header">Login</h2>
            @using (Html.BeginForm("Login", "Login", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                if (ViewBag.Message != null)
                {
                    <div class="error-box">
                        @ViewBag.Message
                    </div>
                }

                <div class="login-label">
                    @Html.LabelFor(a => a.Username):
                </div>

                @Html.TextBoxFor(a => a.Username, new { @class = "login-input"})
                @Html.ValidationMessageFor(a => a.Username, "", new { @class = "field-validation-error" })

                <div class="login-label">
                    @Html.LabelFor(a => a.PasswordHash):
                </div>

                @Html.PasswordFor(a => a.PasswordHash, new { @class = "login-input"})
                @Html.ValidationMessageFor(a => a.PasswordHash, "", new { @class = "field-validation-error" })

                <input type="submit" value="Login" class="btn-login" />
            }

            <form action="/Login/Registration" method="get">
                <button type="submit" class="btn-register">Create Account</button>
            </form>

            <hr class="link-seperator"/>

            <div class="login-links">
                <p class="login-links-text">Or Login With:</p>
                <ul>
                    <li>
                        <a href="#" class="social-link gmail-link" title="Login with Google">
                            <img src="@Url.Content("~/images/google_icon.png")" alt="Google" class="social-icon" />
                        </a>
                    </li>
                    <li>
                        <a href="#" class="social-link email-link" title="Login with Email">
                            <img src="@Url.Content("~/images/email_icon.png")" alt="Email" class="social-icon" />
                        </a>
                    </li>
                </ul>
            </div>

        </div>

        <div class="login-middle-panel">
            <div>
                <img src="/images/RunningMan.png" alt="Alternate Text" class="login-main-icon"/>
                <h1>RUNRS</h1>
            </div>
        </div>

        <div class="login-right-panel">
            <div class="stats-content">
                <div class="stat-item">
                    <h3 class="stat-number">CREATE</h3>
                    <p class="stat-label">Your Own Run Club</p>
                </div>
                <div class="stat-item">
                    <h3 class="stat-number">JOIN</h3>
                    <p class="stat-label">Local Clubs Near You</p>
                </div>
                <div class="stat-item">
                    <h3 class="stat-number">TRACK</h3>
                    <p class="stat-label">Clubs & Events</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>