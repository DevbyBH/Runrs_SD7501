@model Runrs.Models.User

@{
    ViewData["Title"] = "Registration";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <link href="@Url.Content("~/css/site.css")" rel="stylesheet" />
    <title>Register - RUNRS</title>
</head>

<body class="login-body">
    <svg class="background-svg" preserveAspectRatio="xMidYMid slice" viewBox="10 10 80 80">
        <defs>
            <style>
                @@keyframes rotate {
                    0% {
                        transform: rotate(0deg);
                    }

                    100% {
                        transform: rotate(360deg);
                    }
                }

                .out-top {
                    animation: rotate 20s linear infinite;
                    transform-origin: 13px 25px;
                }

                .in-top {
                    animation: rotate 10s linear infinite;
                    transform-origin: 13px 25px;
                }

                .out-bottom {
                    animation: rotate 25s linear infinite;
                    transform-origin: 84px 93px;
                }

                .in-bottom {
                    animation: rotate 15s linear infinite;
                    transform-origin: 84px 93px;
                }
            </style>
        </defs>
        <path fill="#833AB4" class="out-top" d="M37-5C25.1-14.7,5.7-19.1-9.2-10-28.5,1.8-32.7,31.1-19.8,49c15.5,21.5,52.6,22,67.2,2.3C59.4,35,53.7,8.5,37-5Z" />
        <path fill="#2a1344" class="in-top" d="M20.6,4.1C11.6,1.5-1.9,2.5-8,11.2-16.3,23.1-8.2,45.6,7.4,50S42.1,38.9,41,24.5C40.2,14.1,29.4,6.6,20.6,4.1Z" />
        <path fill="#833AB4" class="out-bottom" d="M105.9,48.6c-12.4-8.2-29.3-4.8-39.4.8-23.4,12.8-37.7,51.9-19.1,74.1s63.9,15.3,76-5.6c7.6-13.3,1.8-31.1-2.3-43.8C117.6,63.3,114.7,54.3,105.9,48.6Z" />
        <path fill="#2a1344" class="in-bottom" d="M102,67.1c-9.6-6.1-22-3.1-29.5,2-15.4,10.7-19.6,37.5-7.6,47.8s35.9,3.9,44.5-12.5C115.5,92.6,113.9,74.6,102,67.1Z" />
    </svg>

    <div class="login-main-container">
        <!-- Registration Form Card -->
        <div class="register-card">
            <h2 class="register-header">Create Account</h2>

            <form asp-controller="Login" asp-action="Registration" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger" style="color: #ff4444; font-size: 12px; margin-bottom: 10px;"></div>

                <div class="register-label">
                    <label asp-for="Username">Username:</label>
                </div>
                <input asp-for="Username" class="register-input" placeholder="Enter username" />
                <span asp-validation-for="Username" class="field-validation-error"></span>

                <!-- Name fields side by side -->
                <div class="register-name-row">
                    <div class="register-name-field">
                        <div class="register-row-label">
                            <label asp-for="FirstName">First Name:</label>
                        </div>
                        <input asp-for="FirstName" class="register-input register-input-half" placeholder="First name" />
                        <span asp-validation-for="FirstName" class="field-validation-error"></span>
                    </div>
                    <div class="register-name-field">
                        <div class="register-row-label">
                            <label asp-for="LastName">Last Name:</label>
                        </div>
                        <input asp-for="LastName" class="register-input register-input-half" placeholder="Last name" />
                        <span asp-validation-for="LastName" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="register-label">
                    <label asp-for="Email">Email Address:</label>
                </div>
                <input asp-for="Email" type="email" class="register-input" placeholder="Enter email" />
                <span asp-validation-for="Email" class="field-validation-error"></span>

                <div class="register-label">
                    <label asp-for="PasswordHash">Password:</label>
                </div>
                <input asp-for="PasswordHash" type="password" class="register-input" placeholder="Enter password" />
                <span asp-validation-for="PasswordHash" class="field-validation-error"></span>

                <div class="register-label">
                    <label asp-for="DateOfBirth">Date of Birth:</label>
                </div>
                <input asp-for="DateOfBirth" type="date" class="register-input" />
                <span asp-validation-for="DateOfBirth" class="field-validation-error"></span>

                <input type="submit" value="Create Account" class="btn-register-submit" />
            </form>

            <form action="/Login/Index" method="get">
                <button type="submit" class="btn-back-login">← Back to Login</button>
            </form>
        </div>

        <!-- Brand Middle Panel -->
        <div class="login-middle-panel">
            <div>
                <img src="/images/RunningMan.png" alt="RUNRS Mascot" class="login-main-icon" />
                <h1>RUNRS</h1>
            </div>
        </div>

        <!-- Stats Right Panel -->
        <div class="login-right-panel">
            <div class="stats-content">
                <div class="stat-item">
                    <h3 class="stat-number">CREATE</h3>
                    <p class="stat-label">Your Own Run Club</p>
                </div>
                <div class="stat-item">
                    <h3 class="stat-number">JOIN</h3>
                    <p class="stat-label">Local Clubs Near You</p>
                </div>
                <div class="stat-item">
                    <h3 class="stat-number">TRACK</h3>
                    <p class="stat-label">Clubs & Events</p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>