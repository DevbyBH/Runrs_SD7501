@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var currentUserId = HttpContextAccessor.HttpContext?.Session.GetInt32("UserId") ?? 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Runrs_SD7501</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Runrs_SD7501.styles.css" asp-append-version="true" />
    <script src="https://cdn.tiny.cloud/1/keh4nwipc51vx2f4pihvxkm1u758dgdskzfuxgte34bzcvkt/tinymce/8/tinymce.min.js" referrerpolicy="origin" crossorigin="anonymous"></script>
    <script src="~/js/announcement.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/events.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"> <!-- Byron (10/04/2026) - Added Bootstrap Icons CDN for use across the site -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
</head>

<body class="@ViewData["BodyClass"]">

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white box-shadow mb-3">
            <div class="container-fluid">

                <!-- LOGO -->
                <a class="navbar-brand ms-3" asp-controller="Home" asp-action="Index">
                    <img src="~/images/RunningMan.png" width="50px" />
                </a>

                <!-- TOGGLE -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- CENTER NAV -->
                    <ul class="navbar-nav flex-grow-1 justify-content-center gap-lg-4">

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door-fill" style="padding-right: 10px;"></i>Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Search" asp-action="Index">
                                <i class="bi bi-search" style="padding-right: 10px;"></i>Search
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Club" asp-action="Index">
                                <i class="bi bi-people-fill" style="padding-right: 10px;"></i>My Clubs
                            </a>
                        </li>

                    </ul>

                    <!-- RIGHT SIDE -->
                    <ul class="navbar-nav ms-auto align-items-center gap-3">

                        <!-- PROFILE ICON (OPTIONAL UPGRADE) -->
                        <li class="nav-item">
                            <a class="nav-link text-dark d-flex align-items-center"
                               asp-controller="Profile"
                               asp-action="Details"
                               asp-route-id="@currentUserId">

                                <i class="bi bi-person-circle fs-5 me-1"></i>
                                Profile
                            </a>
                        </li>

                        <!-- LOGOUT -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Login" asp-action="Logout">
                                <i class="bi bi-box-arrow-left" style="padding-right: 10px;"></i>Logout
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Notification" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>